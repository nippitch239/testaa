# Local SQLite (default). For Aurora PostgreSQL later, this becomes your
# cluster connection string, e.g.
# postgres://user:pass@your-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com:5432/securevault
DATABASE_URL="file:./data/vault.db"

# 32-byte AES-256 key, as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=""

# Long random string used to sign session JWTs. Generate with the same
# command as above.
JWT_SECRET=""
