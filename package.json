{
  "name": "securevault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "dev:api": "next dev -p 3001",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "next build",
    "start": "node scripts/start.mjs",
    "preview:web": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "start:api": "next start -p 3001",
    "lint": "eslint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "latest",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "latest"
  }
}
